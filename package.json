{
  "name": "@duckarchive/map",
  "version": "1.6.0",
  "description": "Interactive historical map component for visualizing geographical data over time",
  "keywords": [
    "react",
    "leaflet",
    "map",
    "history",
    "geojson",
    "ukraine",
    "geography"
  ],
  "homepage": "https://github.com/duckarchive/map.duckarchive.com#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duckarchive/map.duckarchive.com.git"
  },
  "bugs": {
    "url": "https://github.com/duckarchive/map.duckarchive.com/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Alexandr Tovmach",
    "email": "alexandrtovmach@gmail.com"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "fetch-ohm-borders": "tsx scripts/fetchAllOHMBorders.ts",
    "filter-by-ua-borders": "tsx scripts/filterByUABorders.ts",
    "rename-feature-props": "tsx scripts/renameFeatureProps.ts",
    "extract-translations": "tsx scripts/extractForTranslations.ts",
    "apply-translations": "tsx scripts/applyTranslations.ts",
    "topo-to-geo": "tsx scripts/convertTopoToGeo.ts",
    "generate-ids": "tsx scripts/generateIds.ts",
    "fix": "tsx scripts/fix.ts",
    "gisloader": "tsx scripts/gisloader.ts",
    "merge": "tsx scripts/merge.ts",
    "minify": "tsx scripts/minify.ts",
    "translator": "tsx scripts/translator.ts",
    "build:lib": "vite build && npx tsc --emitDeclarationOnly --declaration --outDir dist && cp dist/GeoDuckMap/* dist/ && rm -rf dist/GeoDuckMap",
    "preversion": "npm run build:lib && git add dist && (git diff --cached --quiet dist || git commit -m 'release: Build lib for new version')",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@heroui/react": {
      "optional": true
    },
    "@heroui/styles": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "swr": {
      "optional": true
    }
  },
  "dependencies": {
    "leaflet-geosearch": "^4.2.0"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@tailwindcss/vite": "4.1.12",
    "@turf/area": "^7.2.0",
    "@turf/bbox-polygon": "^7.2.0",
    "@turf/boolean-contains": "^7.2.0",
    "@turf/boolean-intersects": "^7.2.0",
    "@turf/boolean-overlap": "^7.2.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/buffer": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/intersect": "^7.2.0",
    "@turf/random": "^7.2.0",
    "@turf/simplify": "^7.2.0",
    "@turf/union": "^7.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.20",
    "@types/lodash": "^4.17.20",
    "@types/proj4": "^2.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.0.0",
    "csv-parse": "^5.5.0",
    "csv-stringify": "^6.6.0",
    "geojson": "^0.5.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "proj4": "^2.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "swr": "^2.3.6",
    "tailwindcss": "^4.1.12",
    "topojson-client": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^3.12.7",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "storybook": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5"
  }
}
